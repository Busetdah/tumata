{
  "manifest_version": 3,
  "name": "Tumata",
  "version": "1.0.0",
  "description": "Tumata — auto-organize your downloads into smart subfolders by file type.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "Tumata",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
